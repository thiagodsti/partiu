# Application version — set this to the Docker image tag so the UI can show it
# and check for updates against GitHub releases.
# Example: PARTIU_VERSION=1.2.0
PARTIU_VERSION=2.2.5

# Required: secret key for signing session cookies
# Generate with: openssl rand -hex 32
SECRET_KEY=

# Optional: path to the SQLite database (default: ./data/partiu.db)
DB_PATH=./data/partiu.db

# Optional: disable background email sync (useful for dev/testing)
DISABLE_SCHEDULER=false

# Optional: set to false when testing over plain HTTP (e.g. mobile on local network)
SECURE_COOKIES=true

# Optional: CARTO basemap API key for the trip map tiles.
# CARTO watermarks unkeyed raster tiles with "API KEY REQUIRED"; leave this
# empty and the map uses plain OpenStreetMap tiles instead, which need no key.
# Free key (5M tiles/month): https://carto.com/basemaps/apikey
CARTO_API_KEY=

# Optional: AviationStack API key for aircraft type lookup (100 req/month free)
# Sign up at https://aviationstack.com → free plan → copy your Access Key
AVIATIONSTACK_API_KEY=

# Optional: Photon geocoder for the station / hotel / address type-ahead.
# Defaults to komoot's PUBLIC instance, so search works out of the box — but
# every place a user types is sent to a shared, rate-limited third party. Point
# this at your own Photon (https://github.com/komoot/photon) to avoid that.
# Set it EMPTY to switch the lookup off entirely: places then save as plain
# text, with no map pin, no timezone conversion, and no visited-country credit.
# PHOTON_URL=https://photon.komoot.io

# Optional: LLM fallback for parsing emails from unknown airlines.
# Requires a running Ollama instance (see docker-compose.yml for the ollama service).
# Leave OLLAMA_URL empty to disable the LLM fallback entirely.
# OLLAMA_URL=http://ollama:11434
# OLLAMA_MODEL=qwen2.5:1.5b

# Optional: public demo instance. With DEMO_MODE=true the login page prints the
# shared demo credentials and offers a one-click sign-in with them, a permanent
# banner says the account is shared, the per-IP sign-in throttles are relaxed
# (a crowd behind one proxy address is not an attacker), and the app refuses
# every change that would lock the next visitor out: enabling 2FA, changing the
# password, and creating, editing or deleting accounts — refused in the backend,
# not merely hidden. Leave it off (the default) on a real install: while it is
# off the endpoint that serves the credentials answers with nothing at all.
# Create the account first — this only advertises it, it does not create it.
# DEMO_MODE=false
# DEMO_USERNAME=demo
# DEMO_PASSWORD=demo1234

# Optional: a short message shown as a banner to every signed-in user.
# ANNOUNCEMENT=Scheduled maintenance on Sunday 02:00-03:00 UTC

# Optional: Web Push (VAPID) keys. Normally generated from
# Settings -> Push notifications rather than set by hand; these exist so a key
# pair can be carried between deployments.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:admin@example.com

# Optional: how long a session cookie stays valid (default: 30)
# SESSION_MAX_AGE_DAYS=30

# Optional: audit log rotation size in MB (default: 10)
# AUDIT_LOG_MAX_MB=10

# Optional: seconds to wait on the Ollama LLM before giving up (default: 180)
# OLLAMA_TIMEOUT=180
