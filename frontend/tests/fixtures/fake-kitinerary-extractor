#!/usr/bin/env python3
"""Stand-in for KDE's kitinerary-extractor on the E2E server.

The real binary is x86_64-only and lives in the Docker image, not on a CI
runner, so scripts/run_e2e.sh points KITINERARY_EXTRACTOR here. It reads the
email from stdin like the real one and prints JSON-LD in the real extractor's
shapes (see backend/tests/test_kitinerary.py): for the email marked
E2E-KIT-JOURNEY, a Stockholm → Oslo train and a concert that evening; for
every other email, nothing — so no other spec's upload is affected.
"""

import json
import sys

mail = sys.stdin.buffer.read().decode("utf-8", "replace")
if "E2E-KIT-JOURNEY" not in mail:
    print("[]")
    sys.exit(0)

print(
    json.dumps(
        [
            {
                "@context": "http://schema.org",
                "@type": "TrainReservation",
                "reservationNumber": "E2EKIT1",
                "reservationStatus": "http://schema.org/ReservationConfirmed",
                "reservationFor": {
                    "@type": "TrainTrip",
                    "departureStation": {
                        "@type": "TrainStation",
                        "name": "Stockholm Central",
                        "geo": {"latitude": 59.3303, "longitude": 18.0588},
                        "address": {"addressCountry": "SE", "addressLocality": "Stockholm"},
                    },
                    "arrivalStation": {
                        "@type": "TrainStation",
                        "name": "Oslo Central",
                        "geo": {"latitude": 59.9111, "longitude": 10.7528},
                        "address": {"addressCountry": "NO", "addressLocality": "Oslo"},
                    },
                    "departureTime": "2027-03-13T07:30:00",
                    "arrivalTime": "2027-03-13T12:30:00",
                    "trainNumber": "SJ 10",
                    "provider": {"@type": "Organization", "name": "SJ"},
                },
                "reservedTicket": {
                    "@type": "Ticket",
                    "ticketedSeat": {"@type": "Seat", "seatNumber": "12", "seatSection": "3"},
                },
            },
            {
                "@context": "http://schema.org",
                "@type": "EventReservation",
                "reservationNumber": "E2ECONCERT",
                "reservationFor": {
                    "@type": "Event",
                    "name": "E2E Fjord Concert",
                    "location": {"@type": "Place", "name": "Oslo Opera House"},
                    "startDate": {
                        "@type": "QDateTime",
                        "@value": "2027-03-13T20:00:00+01:00",
                        "timezone": "Europe/Oslo",
                    },
                },
            },
        ]
    )
)
